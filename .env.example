# Claude (Anthropic) API key used to power Michael AI.
# Michael AI addresses the user as Michael. It is built on Claude under the hood.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default Claude model used for Michael AI.
# Defaults to claude-sonnet-4-6.
MICHAEL_MODEL=claude-sonnet-4-6
